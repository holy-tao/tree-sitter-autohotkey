// Read by both `markdownlint-cli2` (CI, npm run lint:md) and the VS Code
// markdownlint extension, so the editor and CI always agree.
{
  "config": {
    "default": true,
    // Fenced code blocks in the grammar docs use `autohotkey`, which the
    // default language allowlist doesn't know about.
    "MD040": { "allowed_languages": ["autohotkey", "bash", "c", "js", "javascript", "json", "jsonc", "pwsh", "powershell", "scheme", "text", "toml", "yaml"] }
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules",
    "**/node_modules",
    "target",
    "web/dist",
    ".claude",
    "test/fuzz/findings", // generated by test/fuzz/soundness.ps1, not committed
    "test/fuzz/corpus" // fetched corpus, not committed
  ]
}
