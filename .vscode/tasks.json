{
  "version": "2.0.0",
  "tasks": [
    {
      // Same entry point CI uses, so "it passes locally" means it passes in CI.
      "label": "lint: all",
      "type": "shell",
      "command": "make lint",
      "group": "build",
      "problemMatcher": ["$eslint-stylish", "$gcc"],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "lint: fix",
      "type": "shell",
      "command": "make lint-fix",
      "problemMatcher": ["$eslint-stylish", "$gcc"],
      "presentation": { "reveal": "silent", "panel": "dedicated" }
    },
    {
      "label": "test: corpus",
      "type": "shell",
      "command": "tree-sitter generate && tree-sitter test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
